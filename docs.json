{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Swiftbase Documentation",
  "colors": {
    "primary": "#00a3ff",
    "light": "#38bdf8",
    "dark": "#0284c7"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "getting-started/architecture",
          "cli",
          "mcp"
        ]
      },
      {
        "group": "Console Guide",
        "pages": [
          "console/projects",
          "console/identity",
          "console/containers",
          "console/stacks",
          "console/gateways",
          "console/databases",
          "console/storage",
          "console/cache",
          "console/configs",
          "console/vault",
          "console/schedules",
          "console/monitoring",
          "console/ai",
          "console/analytics"
        ]
      },
      {
        "group": "Client SDK",
        "pages": [
          "sdk/overview",
          "sdk/auth",
          "sdk/passkeys",
          "sdk/mfa",
          "sdk/database",
          "sdk/storage",
          "sdk/ai"
        ]
      },
      {
        "group": "Admin SDK",
        "pages": [
          "admin-sdk/overview",
          "admin-sdk/service-auth",
          "admin-sdk/identity-management",
          "admin-sdk/migrations",
          "admin-sdk/configs-vault"
        ]
      },
      {
        "group": "REST API Reference",
        "pages": [
          "api-reference/overview",
          "api-reference/identity",
          "api-reference/containers",
          "api-reference/stacks",
          "api-reference/gateways",
          "api-reference/domains",
          "api-reference/databases",
          "api-reference/storage",
          "api-reference/cache",
          "api-reference/configs",
          "api-reference/vault",
          "api-reference/schedules",
          "api-reference/monitoring",
          "api-reference/ai"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Console",
          "href": "https://app.swiftbase.io",
          "icon": "desktop"
        },
        {
          "anchor": "Swiftbase Homepage",
          "href": "https://swiftbase.io",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.swiftbase.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Console",
      "href": "https://app.swiftbase.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Swiftbase-Dev"
    }
  }
}